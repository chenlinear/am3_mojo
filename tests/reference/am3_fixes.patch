+// am3_mojo fix: the particles that cool into a window of the solver from
+// above within a step. AM3 padded every window with 10 cells above it (the
+// matrix solver of regime 2 without inflow at their top), which drops the
+// particles that start further up and cool into the window within the step,
+// as they do wherever regime 3 or 4 is used above.
+namespace
+{
+	// number of cells above imax (at least 10) from which particles cooling
+	// at A_cool reach imax within dt (one more as margin), up to the cell
+	// above itop, the highest bin with particles
+	int cells_reached(const std::vector<double> &A_cool, int imax, int itop,
+					  int n_bins, double dx, double dt)
+	{
+		double tc = 0.0;
+		int g = imax + 1;
+		while (g < n_bins and g <= itop + 1 and tc <= dt)
+		{
+			tc += dx / (-A_cool[g] + 1e-300);
+			g++;
+		}
+		return std::max(10, g - imax + 1);
+	}
+
+	// (e^u - 1) / u, 1 at u = 0
+	double phi1(double u)
+	{
+		return std::fabs(u) < 1e-12 ? 1.0 : std::expm1(u) / u;
+	}
+
+	// the particles (n dx) that cool across the upper edge x_b = x_ib + dx/2
+	// of bin ib within dt: int_{x_b}^{y_b} [n0 + q (dt - tau)] exp(-S) dx,
+	// tau = int dx'/|A|, S = int a/|A| dx' from x_b, tau(y_b) = dt (exact along
+	// the characteristics for A, a, q constant in the step); n0, q, ln(1/|A|)
+	// and ln(a/|A|) linear between the bin centres above the edge, and the half
+	// cell from the edge to the centre of bin ib + 1 with the values of that
+	// bin (the window above takes them there, and bin ib's particles, in the
+	// window below, are not counted); 4-point Gauss-Legendre in pieces over
+	// which S grows by at most 1; up to the cell above itop, the highest bin
+	// with particles
+	double crossing_count(const std::vector<double> &a_esc,
+						  const std::vector<double> &A_cool,
+						  const std::vector<double> &q_inj,
+						  const std::vector<double> &n0, int ib, int itop,
+						  int n_bins, double dx, double dt)
+	{
+		static const double T[4] = {0.06943184420297371, 0.33000947820757187,
+									0.66999052179242813, 0.93056815579702629};
+		static const double W[4] = {0.17392742256872693, 0.32607257743127307,
+									0.32607257743127307, 0.17392742256872693};
+		if (ib + 1 >= n_bins)
+			return 0.0;
+		double Lj = std::log(1.0 / (-A_cool[ib + 1] + 1e-200));
+		double Mj = std::log((a_esc[ib + 1] + 1e-200) / (-A_cool[ib + 1] + 1e-200));
+		double nj = n0[ib + 1], qj = q_inj[ib + 1];
+		double h = 0.5 * dx, tau = 0.0, S = 0.0, total = 0.0;
+		for (int k = ib + 1; k < n_bins and k <= itop + 1; k++)
+		{
+			double Lk = std::log(1.0 / (-A_cool[k] + 1e-200));
+			double Mk = std::log((a_esc[k] + 1e-200) / (-A_cool[k] + 1e-200));
+			double nk = n0[k], qk = q_inj[k];
+			double dL = Lk - Lj, dM = Mk - Mj;
+			double hL = h * std::exp(Lj), hM = h * std::exp(Mj);
+			double dtau = hL * phi1(dL);
+			double send = h;
+			bool last = false;
+			if (tau + dtau >= dt)
+			{
+				double r = (dt - tau) / hL;
+				send = h * (std::fabs(dL * r) < 1e-12 ? r : std::log1p(dL * r) / dL);
+				last = true;
+			}
+			double dS = hM * phi1(dM * send / h) * send / h;
+			int npiece = dS <= 1.0 ? 1 : std::min(64, (int)std::ceil(dS));
+			double ds = send / npiece;
+			for (int p = 0; p < npiece; p++)
+			{
+				double s0 = ds * p;
+				for (int g = 0; g < 4; g++)
+				{
+					double u = (s0 + ds * T[g]) / h;
+					double tau_s = tau + hL * phi1(dL * u) * u;
+					double S_s = S + hM * phi1(dM * u) * u;
+					double n_s = nj + (nk - nj) * u, q_s = qj + (qk - qj) * u;
+					total += W[g] * ds * (n_s + q_s * std::max(dt - tau_s, 0.0)) * std::exp(-S_s);
+				}
+			}
+			if (last)
+				break;
+			tau += dtau;
+			S += hM * phi1(dM);
+			if (S > 60.0)
+				break;
+			Lj = Lk; Mj = Mk; nj = nk; qj = qk;
+			h = dx;
+		}
+		return total;
+	}
