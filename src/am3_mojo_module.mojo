        _ = t.def_method[_b_set_process_pp_cooling]("set_process_pp_cooling", docstring="set_process_pp_cooling(self: am3_mojo.AM3, arg0: bool) -> None\n\nInclude proton cooling from proton-proton interactions.\nSet to False (off) / True (on)\n")
        _ = t.def_method[_b_set_process_pp_emission]("set_process_pp_emission", docstring="set_process_pp_emission(self: am3_mojo.AM3, arg0: bool) -> None\n\nInclude pion production from proton-proton interactions.\nSet to False (off) / True (on)\n")
