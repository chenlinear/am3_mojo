        _ = t.def_method[_b_set_process_escape]("set_process_escape", docstring="set_process_escape(self: am3_mojo.AM3, arg0: bool) -> None\n\nInclude or exclude physical escape from the region.\nIf on, the escape timescale is determined either by the energy-independent escape timescale (see `set_escape_timescale`) or the energy-dependent escape timescale defined individually for each particle species (see `set_t_<particle>_escape`).\nSet to False (off) / True (on)\n")
        _ = t.def_method[_b_set_process_expansion]("set_process_expansion", docstring="set_process_expansion(self: am3_mojo.AM3, arg0: bool) -> None\n\nInclude or exclude time-dependent dilution of the particle densities due to volume expansion.\nThe expansion rate is given by 1/am3.get_expansion_timescale().\nSet to False (off) / True (on)\n")
        _ = t.def_method[_b_set_process_hadronic]("set_process_hadronic", docstring="set_process_hadronic(self: am3_mojo.AM3, arg0: bool) -> None\n\nInclude or exclude hadronic processes.\nSetting to False turns off all switches belonging to protons, pions and muons, while \nSet to False (turn off hadronics) / True (include hadronics)\n")
        _ = t.def_method[_b_set_process_merge_positrons_into_electrons]("set_process_merge_positrons_into_electrons", docstring="set_process_merge_positrons_into_electrons(self: am3_mojo.AM3, arg0: bool) -> None\n\nAdd up positron and electron densities in the same array, or keep track of them in separate arrays.\nTurning this on leads to a small improvement in performance.\nIf on, the added densities of eletrons and positrons can be checked with get_pairs().\nSet to False (calculate electrons and positrons separately) / True (combine both into electron array)\n")
