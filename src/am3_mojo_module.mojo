        _ = t.def_method[_b_set_optimize_compton_target_grid]("set_optimize_compton_target_grid", docstring="set_optimize_compton_target_grid(self: am3_mojo.AM3, arg0: bool) -> None\n\nFor optimization of electron/positron inverse Compton radiation kernel: False=full target grid, True=every 2nd target grid point.\nThis parameter is only used when set_lep_optimizer_on is turned on.\n")
        _ = t.def_method[_b_set_optimize_photopion_target_photon_grid]("set_optimize_photopion_target_photon_grid", docstring="set_optimize_photopion_target_photon_grid(self: am3_mojo.AM3, arg0: bool) -> None\n\nFor fast version of p-gamma pion-production:  False=full target grid, True=every 2nd target grid point\n")
