        _ = t.def_method[_b_set_process_adiabatic_cooling]("set_process_adiabatic_cooling", docstring="set_process_adiabatic_cooling(self: am3_mojo.AM3, arg0: bool) -> None\n\nInclude adiabatic cooling of charged particles due to expansion.\nThe cooling rate depends on the value of am3.get_expansion_timescale().\nSet to False (off) / True (on)\n")
        _ = t.def_method[_b_set_process_annihilation]("set_process_annihilation", docstring="set_process_annihilation(self: am3_mojo.AM3, arg0: bool) -> None\n\nMaster switch for photon-photon annihilation and resulting pair production (gamma gamma-> e+ e-). \nSet to False (turn off pair emission and photon attenuation due to this process) / True (turn both on; can be switched off individually with respective switches)\n")
        _ = t.def_method[_b_set_process_annihilation_cooling]("set_process_annihilation_cooling", docstring="set_process_annihilation_cooling(self: am3_mojo.AM3, arg0: bool) -> None\n\nInclude the photon disappearance term due to photon-photon interactions.\nSet to False (off) / True (on)\n")
        _ = t.def_method[_b_set_process_annihilation_pair_emission]("set_process_annihilation_pair_emission", docstring="set_process_annihilation_pair_emission(self: am3_mojo.AM3, arg0: bool) -> None\n\nInclude injection of electron/positron pairs due to photon-photon interactions.\nSet to False (off) / True (on)\n")
        _ = t.def_method[_b_set_process_bethe_heitler]("set_process_bethe_heitler", docstring="set_process_bethe_heitler(self: am3_mojo.AM3, arg0: bool) -> None\n\nMaster switch for Bethe-Heitler pair production (p gamma-> p e+ e-).\nSet to False (turn off both pair emission and proton cooling due to this process) / True (turn both on; can be switched off individually with respective switches)\n")
        _ = t.def_method[_b_set_process_bethe_heitler_cooling]("set_process_bethe_heitler_cooling", docstring="set_process_bethe_heitler_cooling(self: am3_mojo.AM3, arg0: bool) -> None\n\nInclude Bethe-Heitler proton cooling.\nSet to False (off) / True (on)\n")
        _ = t.def_method[_b_set_process_bethe_heitler_emission]("set_process_bethe_heitler_emission", docstring="set_process_bethe_heitler_emission(self: am3_mojo.AM3, arg0: bool) -> None\n\nInclude Bethe-Heitler pair production.\nSet to False (off) / True (on)\n")
        _ = t.def_method[_b_set_process_compton_photon_energy_loss]("set_process_compton_photon_energy_loss", docstring="set_process_compton_photon_energy_loss(self: am3_mojo.AM3, arg0: bool) -> None\n\nInclude photon energy losses due to electron/positron scattering. As opposed to inverse Compton, this is the 'regular' Compton scattering where the photons transfer energy to the electrons and positrons.\nSet to False (off) / True (on)\n")
        _ = t.def_method[_b_set_process_electron_compton]("set_process_electron_compton", docstring="set_process_electron_compton(self: am3_mojo.AM3, arg0: bool) -> None\n\nMaster switch for electron/positron inverse Compton emission and cooling.\nSet to False (turn off electron/positron inverse Compton emission and cooling) / True (turn both on; can be switched off individually with respective switches)\n")
