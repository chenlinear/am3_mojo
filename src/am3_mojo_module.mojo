@export
def PyInit_am3_mojo() abi("C") -> PythonObject:
    var env = _save_env()
    initialize_runtime()  # Mojo worker pool used by the parallel sections
    try:
        var m = PythonModuleBuilder("am3_mojo")
        ref t = m.add_type[AM3]("am3_mojo.AM3")
        _ = t.def_init_defaultable[AM3]()
        _ = t.def_method[_b_clear_am3]("clear_am3", docstring="clear_am3(self: am3_mojo.AM3) -> None\n\nSet all current particle densities and injection rates to zero.\n")
        _ = t.def_method[_b_clear_particle_densities]("clear_particle_densities", docstring="clear_particle_densities(self: am3_mojo.AM3) -> None\n\nSet all current particle densities to zero.\n")
        _ = t.def_method[_b_eV_to_had_grid_index]("eV_to_had_grid_index", docstring="eV_to_had_grid_index(self: am3_mojo.AM3, arg0: typing.SupportsFloat | typing.SupportsIndex) -> int\n\nConvert energy [eV] to hadronic energy grid array index\n")
        _ = t.def_method[_b_eV_to_lep_grid_index]("eV_to_lep_grid_index", docstring="eV_to_lep_grid_index(self: am3_mojo.AM3, arg0: typing.SupportsFloat | typing.SupportsIndex) -> int\n\nConvert energy [eV] to electron energy grid array index\n")
        _ = t.def_method[_b_eV_to_neutrino_grid_index]("eV_to_neutrino_grid_index", docstring="eV_to_neutrino_grid_index(self: am3_mojo.AM3, arg0: typing.SupportsFloat | typing.SupportsIndex) -> int\n\nConvert energy [eV] to neutrino energy grid array index\n")
        _ = t.def_method[_b_eV_to_photon_grid_index]("eV_to_photon_grid_index", docstring="eV_to_photon_grid_index(self: am3_mojo.AM3, arg0: typing.SupportsFloat | typing.SupportsIndex) -> int\n\nConvert energy [eV] to photon energy grid array index\n")
        _ = t.def_method[_b_estimate_max_electron_energy]("estimate_max_electron_energy", docstring="estimate_max_electron_energy(self: am3_mojo.AM3) -> None\n\nSet maximum electron energy self-consistently by balancing losses and acceleration\n")
        _ = t.def_method[_b_estimate_max_proton_energy]("estimate_max_proton_energy", docstring="estimate_max_proton_energy(self: am3_mojo.AM3) -> None\n\nSet maximum proton energy self-consistently by balancing losses and acceleration\n")
        _ = t.def_method[_b_evolve_step]("evolve_step", docstring="evolve_step(self: am3_mojo.AM3) -> None\n\nevolve one step\n")
