        _ = t.def_method[_b_set_powerlaw_injection_parameters_electrons]("set_powerlaw_injection_parameters_electrons", docstring="set_powerlaw_injection_parameters_electrons(self: am3_mojo.AM3, arg0: typing.SupportsFloat | typing.SupportsIndex, arg1: typing.SupportsFloat | typing.SupportsIndex, arg2: typing.SupportsFloat | typing.SupportsIndex, arg3: typing.SupportsFloat | typing.SupportsIndex, arg4: typing.SupportsFloat | typing.SupportsIndex, arg5: typing.SupportsFloat | typing.SupportsIndex, arg6: typing.SupportsFloat | typing.SupportsIndex, arg7: typing.SupportsFloat | typing.SupportsIndex) -> None\n\nSet parameters of the power-law injection of electrons.\nParams: region volume [cm-3], injection luminosity [erg/s], minimum energy [eV], break energy [eV], maximum energy [eV], spectral index below the break, spectral index above the break, and exponential cutoff steepness.\nDefault: 1.13e50, 0.0, 1e7, 1e7, 1e13, 2.0, 2.0, 1.0\n")
        _ = t.def_method[_b_set_powerlaw_injection_parameters_protons]("set_powerlaw_injection_parameters_protons", docstring="set_powerlaw_injection_parameters_protons(self: am3_mojo.AM3, arg0: typing.SupportsFloat | typing.SupportsIndex, arg1: typing.SupportsFloat | typing.SupportsIndex, arg2: typing.SupportsFloat | typing.SupportsIndex, arg3: typing.SupportsFloat | typing.SupportsIndex, arg4: typing.SupportsFloat | typing.SupportsIndex, arg5: typing.SupportsFloat | typing.SupportsIndex, arg6: typing.SupportsFloat | typing.SupportsIndex, arg7: typing.SupportsFloat | typing.SupportsIndex) -> None\n\nSet parameters of the power-law injection of protons.\nParams: region volume [cm-3], injection luminosity [erg/s], minimum energy [eV], break energy [eV], maximum energy [eV], spectral index below the break, spectral index above the break, and exponential cutoff steepness.\nDefault: 1.13e50, 0.0, 1e10, 1e10, 1e15, 2.0, 2.0, 1.0\n")
