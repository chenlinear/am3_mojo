        _ = t.def_method[_b_set_optimize_bethe_heitler_incoming_protons_min]("set_optimize_bethe_heitler_incoming_protons_min", docstring="set_optimize_bethe_heitler_incoming_protons_min(self: am3_mojo.AM3, arg0: typing.SupportsFloat | typing.SupportsIndex) -> None\n\nFor fast version of Bethe-Heitler e-production: min. target proton energy\nThis parameter is only used when set_had_optimizer_on is tuned on.\nDefault: 1 TeV\n")
        _ = t.def_method[_b_set_optimize_bethe_heitler_outgoing_pairs_grid]("set_optimize_bethe_heitler_outgoing_pairs_grid", docstring="set_optimize_bethe_heitler_outgoing_pairs_grid(self: am3_mojo.AM3, arg0: bool) -> None\n\nFor fast version of Bethe-Heitler e-production: False=full electrons and positrons out grid, True=every 2nd electrons and positrons grid point + interpolation\nThis parameter is only used when set_had_optimizer_on is tuned on.\n")
        _ = t.def_method[_b_set_optimize_bethe_heitler_target_photon_max]("set_optimize_bethe_heitler_target_photon_max", docstring="set_optimize_bethe_heitler_target_photon_max(*args, **kwargs)\nOverloaded function.\n\n1. set_optimize_bethe_heitler_target_photon_max(self: am3_mojo.AM3, arg0: typing.SupportsFloat | typing.SupportsIndex) -> None\n\noptimisation of full kernel of injection of lepton pairs due to gamma gamma pair annihilation: factor above threshold energy where to stop kernel\nThis parameter is only used when set_had_optimizer_on is tuned on.\nDefault: 1e6\n\n2. set_optimize_bethe_heitler_target_photon_max(self: am3_mojo.AM3, arg0: typing.SupportsFloat | typing.SupportsIndex) -> None\n\nFor fast version of Bethe-Heitler e-production: max. target photon energy\nThis parameter is only used when set_had_optimizer_on is tuned on.\nDefault: 1 MeV (approx. m_e c^2)\n")
        _ = t.def_method[_b_set_optimize_compton_emission_emin]("set_optimize_compton_emission_emin", docstring="set_optimize_compton_emission_emin(self: am3_mojo.AM3, arg0: typing.SupportsFloat | typing.SupportsIndex) -> None\n\nFor optimization of electron/positron inverse Compton radiation kernel: min. out. photon energy to include in IC calculation.\nThis parameter is only used when set_lep_optimizer_on is turned on.\nDefault: 1e-3 eV\n")
        _ = t.def_method[_b_set_optimize_compton_emission_grid]("set_optimize_compton_emission_grid", docstring="set_optimize_compton_emission_grid(self: am3_mojo.AM3, arg0: bool) -> None\n\nFor optimization of electron/positron inverse Compton radiation kernel: False=full photon out grid, True=every 2nd photon grid point + interpolation.\nThis parameter is only used when set_lep_optimizer_on is turned on.\n")
