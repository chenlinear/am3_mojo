        _ = t.def_method[_b_set_escape_timescale]("set_escape_timescale", docstring="set_escape_timescale(self: am3_mojo.AM3, arg0: typing.SupportsFloat | typing.SupportsIndex) -> None\n\nSet timescale for escape, generally the light-crossing time of the region [s].\nThe actual escape timescape of each particle species will be set to this timescale divided by an individual escape factor.\nDefault: 1e6.\n")
