        _ = t.def_method[_b_set_process_proton_compton]("set_process_proton_compton", docstring="set_process_proton_compton(self: am3_mojo.AM3, arg0: bool) -> None\n\nMaster switch for proton inverse Compton.\nSet to False (turn off proton inverse Compton emission and cooling) / True (turn both on; can be switched off individually with respective switches)\n")
        _ = t.def_method[_b_set_process_proton_compton_cooling]("set_process_proton_compton_cooling", docstring="set_process_proton_compton_cooling(self: am3_mojo.AM3, arg0: bool) -> None\n\nInclude proton inverse Compton cooling.\nSet to False (off) / True (on)\n")
        _ = t.def_method[_b_set_process_proton_compton_emission]("set_process_proton_compton_emission", docstring="set_process_proton_compton_emission(self: am3_mojo.AM3, arg0: bool) -> None\n\nInclude proton inverse Compton emission.\nSet to False (off) / True (on)\n")
        _ = t.def_method[_b_set_process_proton_syn]("set_process_proton_syn", docstring="set_process_proton_syn(self: am3_mojo.AM3, arg0: bool) -> None\n\nMaster switch for proton synchrotron.\nSet to False (turn off proton synchrotron emission and cooling) / True (turn both on; can be switched off individually with respective switches)\n")
        _ = t.def_method[_b_set_process_proton_syn_cooling]("set_process_proton_syn_cooling", docstring="set_process_proton_syn_cooling(self: am3_mojo.AM3, arg0: bool) -> None\n\nInclude proton synchrotron cooling.\nSet to False (off) / True (on)\n")
        _ = t.def_method[_b_set_process_proton_syn_emission]("set_process_proton_syn_emission", docstring="set_process_proton_syn_emission(self: am3_mojo.AM3, arg0: bool) -> None\n\nInclude proton synchrotron emission.\nSet to False (off) / True (on)\n")
        _ = t.def_method[_b_set_process_quantum_syn]("set_process_quantum_syn", docstring="set_process_quantum_syn(self: am3_mojo.AM3, arg0: bool) -> None\n\nInclude quantum regime for synchrotron emission from electrons and positrons.\nThis effect is relevant for strong enough magnetic fields, when the electron recoil becomes significant, parallel to the Klein-Nishina regime of inverse Compton. Turning it off leads to an improvement in performance.\nSet to False (off) / True (on)\n")
        _ = t.def_method[_b_set_process_quantum_syn_cooling]("set_process_quantum_syn_cooling", docstring="set_process_quantum_syn_cooling(self: am3_mojo.AM3, arg0: bool) -> None\n\nInclude quantum regime for synchrotron cooling of all charged particles.\nSet to False (off) / True (on)\n")
        _ = t.def_method[_b_set_process_ssa]("set_process_ssa", docstring="set_process_ssa(self: am3_mojo.AM3, arg0: bool) -> None\n\nInclude or exclude synchrotron self-absorption by electrons and positrons.\nSet to False (off) / True (on)\n")
        _ = t.def_method[_b_set_profile_timing]("set_profile_timing", docstring="set_profile_timing(self: am3_mojo.AM3, arg0: bool) -> None\n\nSets value of switch if run-times are measured (True=yes, False=no)\n")
        _ = t.def_method[_b_set_proton_accel_factor]("set_proton_accel_factor", docstring="set_proton_accel_factor(self: am3_mojo.AM3, arg0: typing.SupportsFloat | typing.SupportsIndex) -> None\n\nInverse of acceleration efficiency used when calculating self-consistently the maximum proton energy [fraction of proton Larmor radius].\nThis is only used when set_estimate_max_energies has been tuned on.\n")
        _ = t.def_method[_b_set_solver_simpleqintegration]("set_solver_simpleqintegration", docstring="set_solver_simpleqintegration(self: am3_mojo.AM3, arg0: bool) -> None\n\nSwitch for a simpler and more robust version of the source term integral in the semianalytical solver.\nSet to False (off) / True (on).\nDefault: False\n")
        _ = t.def_method[_b_set_solver_threshold_cool_dom]("set_solver_threshold_cool_dom", docstring="set_solver_threshold_cool_dom(self: am3_mojo.AM3, arg0: typing.SupportsFloat | typing.SupportsIndex) -> None\n\nThreshold level of the fraction between the escape and cooling terms below which cooling is ignored.\nDefault:  1e-2\n")
        _ = t.def_method[_b_set_solver_threshold_esc_dom]("set_solver_threshold_esc_dom", docstring="set_solver_threshold_esc_dom(self: am3_mojo.AM3, arg0: typing.SupportsFloat | typing.SupportsIndex) -> None\n\nThreshold level of the fraction between the cooling and cooling terms below which escape is ignored.\nDefault:  1e-2\n")
        _ = t.def_method[_b_set_solver_threshold_matrix]("set_solver_threshold_matrix", docstring="set_solver_threshold_matrix(self: am3_mojo.AM3, arg0: typing.SupportsFloat | typing.SupportsIndex) -> None\n\nThreshold level of the fraction between the threshold_matrix/A and dt/dx below which we switch to analytic step in the following time step.\nDefault:  100\n")
        _ = t.def_method[_b_set_solver_time_step]("set_solver_time_step", docstring="set_solver_time_step(self: am3_mojo.AM3, arg0: typing.SupportsFloat | typing.SupportsIndex) -> None\n\nSet timestep of the numerical solver [s]. For very optically thick environments where max rate >> 100 * escape rate, it is advised to test lower time step values to make sure there are no hardness-related imprecisions in the result.\nDefault: 0.01 * escape_timescale\n")
        _ = t.def_method[_b_set_t_muon_escape]("set_t_muon_escape", docstring="set_t_muon_escape(self: am3_mojo.AM3, arg0: typing.Annotated[numpy.typing.ArrayLike, numpy.float64]) -> None\n\nSet escape timescale of muons as an array. [s]\n")
        _ = t.def_method[_b_set_t_muon_extra_cooling]("set_t_muon_extra_cooling", docstring="set_t_muon_extra_cooling(self: am3_mojo.AM3, arg0: typing.Annotated[numpy.typing.ArrayLike, numpy.float64]) -> None\n\nSet extra cooling timescale of muons as an array. [s]\n")
        _ = t.def_method[_b_set_t_neutrino_escape]("set_t_neutrino_escape", docstring="set_t_neutrino_escape(self: am3_mojo.AM3, arg0: typing.Annotated[numpy.typing.ArrayLike, numpy.float64]) -> None\n\nSet escape timescale of neutrinos as an array. [s]\n")
        _ = t.def_method[_b_set_t_neutrino_extra_cooling]("set_t_neutrino_extra_cooling", docstring="set_t_neutrino_extra_cooling(self: am3_mojo.AM3, arg0: typing.Annotated[numpy.typing.ArrayLike, numpy.float64]) -> None\n\nSet extra cooling timescale of neutrinos as an array. [s]\n")
        _ = t.def_method[_b_set_t_neutron_escape]("set_t_neutron_escape", docstring="set_t_neutron_escape(self: am3_mojo.AM3, arg0: typing.Annotated[numpy.typing.ArrayLike, numpy.float64]) -> None\n\nSet escape timescale of neutrons as an array. [s]\n")
        _ = t.def_method[_b_set_t_neutron_extra_cooling]("set_t_neutron_extra_cooling", docstring="set_t_neutron_extra_cooling(self: am3_mojo.AM3, arg0: typing.Annotated[numpy.typing.ArrayLike, numpy.float64]) -> None\n\nSet extra cooling timescale of neutrons as an array. [s]\n")
        _ = t.def_method[_b_set_t_pair_escape]("set_t_pair_escape", docstring="set_t_pair_escape(self: am3_mojo.AM3, arg0: typing.Annotated[numpy.typing.ArrayLike, numpy.float64]) -> None\n\nSet escape timescale of electrons/positrons as an array. [s]\n")
        _ = t.def_method[_b_set_t_pair_extra_cooling]("set_t_pair_extra_cooling", docstring="set_t_pair_extra_cooling(self: am3_mojo.AM3, arg0: typing.Annotated[numpy.typing.ArrayLike, numpy.float64]) -> None\n\nSet extra cooling timescale of electrons/positrons as an array. [s]\n")
        _ = t.def_method[_b_set_t_photon_escape]("set_t_photon_escape", docstring="set_t_photon_escape(self: am3_mojo.AM3, arg0: typing.Annotated[numpy.typing.ArrayLike, numpy.float64]) -> None\n\nSet escape timescale of photons as an array. [s]\n")
        _ = t.def_method[_b_set_t_photon_extra_cooling]("set_t_photon_extra_cooling", docstring="set_t_photon_extra_cooling(self: am3_mojo.AM3, arg0: typing.Annotated[numpy.typing.ArrayLike, numpy.float64]) -> None\n\nSet extra cooling timescale of photons as an array. [s]\n")
        _ = t.def_method[_b_set_t_pion_escape]("set_t_pion_escape", docstring="set_t_pion_escape(self: am3_mojo.AM3, arg0: typing.Annotated[numpy.typing.ArrayLike, numpy.float64]) -> None\n\nSet escape timescale of pions as an array. [s]\n")
        _ = t.def_method[_b_set_t_pion_extra_cooling]("set_t_pion_extra_cooling", docstring="set_t_pion_extra_cooling(self: am3_mojo.AM3, arg0: typing.Annotated[numpy.typing.ArrayLike, numpy.float64]) -> None\n\nSet extra cooling timescale of pions as an array. [s]\n")
        _ = t.def_method[_b_set_t_proton_escape]("set_t_proton_escape", docstring="set_t_proton_escape(self: am3_mojo.AM3, arg0: typing.Annotated[numpy.typing.ArrayLike, numpy.float64]) -> None\n\nSet escape timescale of protons as an array. [s]\n")
        _ = t.def_method[_b_set_t_proton_extra_cooling]("set_t_proton_extra_cooling", docstring="set_t_proton_extra_cooling(self: am3_mojo.AM3, arg0: typing.Annotated[numpy.typing.ArrayLike, numpy.float64]) -> None\n\nSet extra cooling timescale of protons as an array. [s]\n")
        _ = t.def_method[_b_set_verbosity_level]("set_verbosity_level", docstring="set_verbosity_level(self: am3_mojo.AM3, arg0: bool) -> None\n\nSet verbosity level.\n\nSet to False (minimal output) / True (more detailed output on simulation steps).\nDefault: False\n\n\n")
        _ = t.def_method[_b_update_energy_grid]("update_energy_grid", docstring="update_energy_grid(self: am3_mojo.AM3, arg0: typing.SupportsFloat | typing.SupportsIndex, arg1: typing.SupportsFloat | typing.SupportsIndex, arg2: typing.SupportsFloat | typing.SupportsIndex) -> None\n\nupdate energy grid. Requires Reinitialisation of kernels.\nParams: min. photon energy [eV], min. neutrino energy [eV], max. energy for all particles [eV]\n")
        _ = t.def_method[_b_get_process_pair_annihilation]("get_process_pair_annihilation", docstring="get_process_pair_annihilation(self: am3_mojo.AM3) -> bool\n\nCheck the current value of the master switch for e+e- annihilation (am3_mojo addition).\nSee `set_process_pair_annihilation`.\n")
        _ = t.def_method[_b_set_process_pair_annihilation]("set_process_pair_annihilation", docstring="set_process_pair_annihilation(self: am3_mojo.AM3, arg0: bool) -> None\n\nMaster switch for electron-positron annihilation, e+ e- -> gamma gamma (am3_mojo addition; not the\nphoton-photon annihilation into pairs of `set_process_annihilation`), with Svensson's (1982) exact rates and\nphoton spectra. Needs `set_process_merge_positrons_into_electrons(False)` (the default). A step's sinks and\nphotons come from the densities at its start: keep the time step below about 0.05 of the shortest\nannihilation time (`get_t_electron_annihilation()`, `get_t_positron_annihilation()`).\nSet to False (no e+e- annihilation, as in AM3) / True (photon emission and e+/- loss, each with its own switch). Default: True.\n")
        _ = t.def_method[_b_get_process_pair_annihilation_emission]("get_process_pair_annihilation_emission", docstring="get_process_pair_annihilation_emission(self: am3_mojo.AM3) -> bool\n\nCheck the current value of the switch that controls the photon emission of e+e- annihilation (am3_mojo addition).\nSee `set_process_pair_annihilation_emission`.\n")
        _ = t.def_method[_b_set_process_pair_annihilation_emission]("set_process_pair_annihilation_emission", docstring="set_process_pair_annihilation_emission(self: am3_mojo.AM3, arg0: bool) -> None\n\nSwitch for the photons from e+e- annihilation (am3_mojo addition).\nSet to False / True. Default: True.\nThe master switch `set_process_pair_annihilation` must be True for emission to be on.\n")
        _ = t.def_method[_b_get_process_pair_annihilation_cooling]("get_process_pair_annihilation_cooling", docstring="get_process_pair_annihilation_cooling(self: am3_mojo.AM3) -> bool\n\nCheck the current value of the switch that controls the e+/- loss by e+e- annihilation (am3_mojo addition).\nSee `set_process_pair_annihilation_cooling`.\n")
        _ = t.def_method[_b_set_process_pair_annihilation_cooling]("set_process_pair_annihilation_cooling", docstring="set_process_pair_annihilation_cooling(self: am3_mojo.AM3, arg0: bool) -> None\n\nSwitch for the loss of electrons and positrons by e+e- annihilation (am3_mojo addition).\nSet to False / True. Default: True.\nThe master switch `set_process_pair_annihilation` must be True for the loss to be on.\n")
        _ = t.def_method[_b_get_photons_pair_annihilation]("get_photons_pair_annihilation", docstring="get_photons_pair_annihilation(self: am3_mojo.AM3) -> numpy.typing.NDArray[numpy.float64]\n\nGet array with EdN_dEdV [1/cm³] of photons from e+e- annihilation (am3_mojo addition)\n")
        _ = t.def_method[_b_get_t_electron_annihilation]("get_t_electron_annihilation", docstring="get_t_electron_annihilation(self: am3_mojo.AM3) -> numpy.typing.NDArray[numpy.float64]\n\nGet timescale array of electron loss by annihilation with positrons [s] (am3_mojo addition)\n")
        _ = t.def_method[_b_get_t_positron_annihilation]("get_t_positron_annihilation", docstring="get_t_positron_annihilation(self: am3_mojo.AM3) -> numpy.typing.NDArray[numpy.float64]\n\nGet timescale array of positron loss by annihilation with electrons [s] (am3_mojo addition)\n")
        _ = t.def_method[_b_get_process_triplet_pair_production]("get_process_triplet_pair_production", docstring="get_process_triplet_pair_production(self: am3_mojo.AM3) -> bool\n\nCheck the current value of the master switch for triplet pair production, e+- gamma -> e+- e+ e- (am3_mojo addition).\nSee `set_process_triplet_pair_production`.\n")
        _ = t.def_method[_b_set_process_triplet_pair_production]("set_process_triplet_pair_production", docstring="set_process_triplet_pair_production(self: am3_mojo.AM3, arg0: bool) -> None\n\nMaster switch for triplet pair production, e+- gamma -> e+- e+ e- (am3_mojo addition), from the lowest-order\nQED matrix element (all eight diagrams), for ultra-relativistic leptons on photons below m_e c^2. The leptons\nlose the energy the pairs take (a continuous loss), the pairs are injected and evolved as the component\n`get_pairs_triplet`, and the photons are absorbed.\nSet to False (no triplet pair production, as in AM3) / True (pair emission and e+/- loss, each with its own switch). Default: True.\n")
        _ = t.def_method[_b_get_process_triplet_pair_production_emission]("get_process_triplet_pair_production_emission", docstring="get_process_triplet_pair_production_emission(self: am3_mojo.AM3) -> bool\n\nCheck the current value of the switch that controls the pair emission of triplet pair production (am3_mojo addition).\nSee `set_process_triplet_pair_production_emission`.\n")
        _ = t.def_method[_b_set_process_triplet_pair_production_emission]("set_process_triplet_pair_production_emission", docstring="set_process_triplet_pair_production_emission(self: am3_mojo.AM3, arg0: bool) -> None\n\nSwitch for the emission of the pairs made in triplet pair production (am3_mojo addition).\nSet to False / True. Default: True.\nThe master switch `set_process_triplet_pair_production` must be True for the emission to be on.\n")
        _ = t.def_method[_b_get_process_triplet_pair_production_cooling]("get_process_triplet_pair_production_cooling", docstring="get_process_triplet_pair_production_cooling(self: am3_mojo.AM3) -> bool\n\nCheck the current value of the switch that controls the e+- energy loss by triplet pair production (am3_mojo addition).\nSee `set_process_triplet_pair_production_cooling`.\n")
        _ = t.def_method[_b_set_process_triplet_pair_production_cooling]("set_process_triplet_pair_production_cooling", docstring="set_process_triplet_pair_production_cooling(self: am3_mojo.AM3, arg0: bool) -> None\n\nSwitch for the energy loss of electrons and positrons by triplet pair production (am3_mojo addition):\nthe energy the produced pairs take, as a continuous loss.\nSet to False / True. Default: True.\nThe master switch `set_process_triplet_pair_production` must be True for the loss to be on.\n")
        _ = t.def_method[_b_get_pairs_triplet]("get_pairs_triplet", docstring="get_pairs_triplet(self: am3_mojo.AM3) -> numpy.typing.NDArray[numpy.float64]\n\nGet array with EdN_dEdV [1/cm³] of e+- pairs from triplet pair production (am3_mojo addition)\n")
        _ = t.def_method[_b_get_photons_triplet_pairs_syn]("get_photons_triplet_pairs_syn", docstring="get_photons_triplet_pairs_syn(self: am3_mojo.AM3) -> numpy.typing.NDArray[numpy.float64]\n\nGet array with EdN_dEdV [1/cm³] of synchrotron photons from pairs from triplet pair production (am3_mojo addition)\n")
        _ = t.def_method[_b_get_photons_triplet_pairs_compton]("get_photons_triplet_pairs_compton", docstring="get_photons_triplet_pairs_compton(self: am3_mojo.AM3) -> numpy.typing.NDArray[numpy.float64]\n\nGet array with EdN_dEdV [1/cm³] of inverse-Compton photons from pairs from triplet pair production (am3_mojo addition)\n")
        _ = t.def_method[_b_get_photons_triplet_pairs_syn_compton]("get_photons_triplet_pairs_syn_compton", docstring="get_photons_triplet_pairs_syn_compton(self: am3_mojo.AM3) -> numpy.typing.NDArray[numpy.float64]\n\nGet array with EdN_dEdV [1/cm³] of synchrotron and inverse-Compton photons from pairs from triplet pair production (am3_mojo addition)\n")
        _ = t.def_method[_b_get_t_pair_triplet]("get_t_pair_triplet", docstring="get_t_pair_triplet(self: am3_mojo.AM3) -> numpy.typing.NDArray[numpy.float64]\n\nGet timescale array of e+- energy loss by triplet pair production [s] (am3_mojo addition)\n")
        _ = t.def_method[_b_get_t_photon_triplet]("get_t_photon_triplet", docstring="get_t_photon_triplet(self: am3_mojo.AM3) -> numpy.typing.NDArray[numpy.float64]\n\nGet timescale array of photon absorption by triplet pair production [s] (am3_mojo addition)\n")
        _ = t.def_method[_b_get_process_neutron_decay]("get_process_neutron_decay", docstring="get_process_neutron_decay(self: am3_mojo.AM3) -> bool\n\nCheck the current value of the switch for neutron decay, n -> p e- anti-nu_e (am3_mojo addition).\nSee `set_process_neutron_decay`.\n")
        _ = t.def_method[_b_set_process_neutron_decay]("set_process_neutron_decay", docstring="set_process_neutron_decay(self: am3_mojo.AM3, arg0: bool) -> None\n\nSwitch for neutron decay, n -> p e- anti-nu_e (am3_mojo addition), at the rate 1/(gamma tau_n) with the\nmean life of PDG 2026. The protons, electrons and electron anti-neutrinos are injected with the spectra of the\ndecay: the allowed beta spectrum with the Coulomb correction, boosted exactly to the neutron energy. The\nelectrons and anti-neutrinos are also components (`get_electrons_neutron_decay`,\n`get_electron_anti_neutrinos_neutron_decay`). Needs the hadronic processes; set it before `init_kernels`.\nSet to False (neutrons do not decay, as in AM3) / True. Default: True.\n")
        _ = t.def_method[_b_get_electrons_neutron_decay]("get_electrons_neutron_decay", docstring="get_electrons_neutron_decay(self: am3_mojo.AM3) -> numpy.typing.NDArray[numpy.float64]\n\nGet array with EdN_dEdV [1/cm³] of electrons from neutron decay (am3_mojo addition)\n")
        _ = t.def_method[_b_get_photons_neutron_decay_electrons_syn]("get_photons_neutron_decay_electrons_syn", docstring="get_photons_neutron_decay_electrons_syn(self: am3_mojo.AM3) -> numpy.typing.NDArray[numpy.float64]\n\nGet array with EdN_dEdV [1/cm³] of synchrotron photons from electrons from neutron decay (am3_mojo addition)\n")
        _ = t.def_method[_b_get_photons_neutron_decay_electrons_compton]("get_photons_neutron_decay_electrons_compton", docstring="get_photons_neutron_decay_electrons_compton(self: am3_mojo.AM3) -> numpy.typing.NDArray[numpy.float64]\n\nGet array with EdN_dEdV [1/cm³] of inverse-Compton photons from electrons from neutron decay (am3_mojo addition)\n")
        _ = t.def_method[_b_get_photons_neutron_decay_electrons_syn_compton]("get_photons_neutron_decay_electrons_syn_compton", docstring="get_photons_neutron_decay_electrons_syn_compton(self: am3_mojo.AM3) -> numpy.typing.NDArray[numpy.float64]\n\nGet array with EdN_dEdV [1/cm³] of synchrotron and inverse-Compton photons from electrons from neutron decay (am3_mojo addition)\n")
        _ = t.def_method[_b_get_electron_anti_neutrinos_neutron_decay]("get_electron_anti_neutrinos_neutron_decay", docstring="get_electron_anti_neutrinos_neutron_decay(self: am3_mojo.AM3) -> numpy.typing.NDArray[numpy.float64]\n\nGet array with EdN_dEdV [1/cm³] of electron anti-neutrinos from neutron decay (am3_mojo addition)\n")
        _ = t.def_method[_b_get_t_neutron_decay]("get_t_neutron_decay", docstring="get_t_neutron_decay(self: am3_mojo.AM3) -> numpy.typing.NDArray[numpy.float64]\n\nGet timescale array of neutron decay [s] (am3_mojo addition)\n")
        _ = t.def_method[_b_get_process_kaons]("get_process_kaons", docstring="get_process_kaons(self: am3_mojo.AM3) -> bool\n\nCheck the current value of the master switch for the kaons K+, K-, K0_S and K0_L (am3_mojo addition).\nSee `set_process_kaons`.\n")
        _ = t.def_method[_b_set_process_kaons]("set_process_kaons", docstring="set_process_kaons(self: am3_mojo.AM3, arg0: bool) -> None\n\nMaster switch for kaons (am3_mojo addition): K+, K-, K0_S and K0_L from photo-hadronic interactions of\nprotons and neutrons and from pp collisions, their escape, cooling (synchrotron and inverse Compton for K+-)\nand decay, and the decay products (pions, muons, e+-, neutrinos). Needs the photo-pion or the pp process\nwith its emission. With kaons on, the pion yields of the photo-hadronic multi-pion types are reduced by the\nkaons' energy, and in pp collisions the protons also lose the kaons' energy.\nSet to False (no kaons, as in AM3) / True. Default: True.\n")
        _ = t.def_method[_b_get_process_kaon_decay]("get_process_kaon_decay", docstring="get_process_kaon_decay(self: am3_mojo.AM3) -> bool\n\nCheck the current value of the switch for kaon decay (am3_mojo addition).\nSee `set_process_kaon_decay`.\n")
        _ = t.def_method[_b_set_process_kaon_decay]("set_process_kaon_decay", docstring="set_process_kaon_decay(self: am3_mojo.AM3, arg0: bool) -> None\n\nSwitch for kaon decay (am3_mojo addition): every non-radiative mode of K+-, K0_S and K0_L with a\nbranching ratio above 0.1 % (PDG 2026) and the smaller K0_S semileptonic and K0_L -> pi0 pi0 modes.\nSet to False (kaons do not decay) / True. Default: True.\n")
        _ = t.def_method[_b_get_process_kaon_syn]("get_process_kaon_syn", docstring="get_process_kaon_syn(self: am3_mojo.AM3) -> bool\n\nCheck the current value of the master switch for kaon synchrotron (am3_mojo addition).\nSee `set_process_kaon_syn`.\n")
        _ = t.def_method[_b_set_process_kaon_syn]("set_process_kaon_syn", docstring="set_process_kaon_syn(self: am3_mojo.AM3, arg0: bool) -> None\n\nMaster switch for the synchrotron radiation of charged kaons (am3_mojo addition).\nSet to False (turn off kaon synchrotron emission and cooling) / True (turn both on; each can be switched off separately). Default: True.\n")
        _ = t.def_method[_b_get_process_kaon_syn_emission]("get_process_kaon_syn_emission", docstring="get_process_kaon_syn_emission(self: am3_mojo.AM3) -> bool\n\nCheck the current value of the switch that controls kaon synchrotron emission (am3_mojo addition).\nSee `set_process_kaon_syn_emission`.\nNote also the value of the master switch `get_process_kaon_syn()`, which controls both emission and cooling.\n")
        _ = t.def_method[_b_set_process_kaon_syn_emission]("set_process_kaon_syn_emission", docstring="set_process_kaon_syn_emission(self: am3_mojo.AM3, arg0: bool) -> None\n\nSwitch for kaon synchrotron emission (am3_mojo addition).\nSet to False / True. Default: True.\nThe master switch `set_process_kaon_syn` must be True for emission to be on.\n")
        _ = t.def_method[_b_get_process_kaon_syn_cooling]("get_process_kaon_syn_cooling", docstring="get_process_kaon_syn_cooling(self: am3_mojo.AM3) -> bool\n\nCheck the current value of the switch that controls kaon synchrotron cooling (am3_mojo addition).\nSee `set_process_kaon_syn_cooling`.\nNote also the value of the master switch `get_process_kaon_syn()`, which controls both emission and cooling.\n")
        _ = t.def_method[_b_set_process_kaon_syn_cooling]("set_process_kaon_syn_cooling", docstring="set_process_kaon_syn_cooling(self: am3_mojo.AM3, arg0: bool) -> None\n\nSwitch for kaon synchrotron cooling (am3_mojo addition).\nSet to False / True. Default: True.\nThe master switch `set_process_kaon_syn` must be True for cooling to be on.\n")
        _ = t.def_method[_b_get_process_kaon_compton]("get_process_kaon_compton", docstring="get_process_kaon_compton(self: am3_mojo.AM3) -> bool\n\nCheck the current value of the master switch for kaon inverse Compton (am3_mojo addition).\nSee `set_process_kaon_compton`.\n")
        _ = t.def_method[_b_set_process_kaon_compton]("set_process_kaon_compton", docstring="set_process_kaon_compton(self: am3_mojo.AM3, arg0: bool) -> None\n\nMaster switch for the inverse Compton scattering of charged kaons (am3_mojo addition), treated as for charged pions.\nSet to False (turn off kaon inverse Compton emission and cooling) / True (turn both on; each can be switched off separately). Default: True.\n")
        _ = t.def_method[_b_get_process_kaon_compton_emission]("get_process_kaon_compton_emission", docstring="get_process_kaon_compton_emission(self: am3_mojo.AM3) -> bool\n\nCheck the current value of the switch that controls kaon inverse Compton emission (am3_mojo addition).\nSee `set_process_kaon_compton_emission`.\nNote also the value of the master switch `get_process_kaon_compton()`, which controls both emission and cooling.\n")
        _ = t.def_method[_b_set_process_kaon_compton_emission]("set_process_kaon_compton_emission", docstring="set_process_kaon_compton_emission(self: am3_mojo.AM3, arg0: bool) -> None\n\nSwitch for kaon inverse Compton emission (am3_mojo addition).\nSet to False / True. Default: True.\nThe master switch `set_process_kaon_compton` must be True for emission to be on.\n")
        _ = t.def_method[_b_get_process_kaon_compton_cooling]("get_process_kaon_compton_cooling", docstring="get_process_kaon_compton_cooling(self: am3_mojo.AM3) -> bool\n\nCheck the current value of the switch that controls kaon inverse Compton cooling (am3_mojo addition).\nSee `set_process_kaon_compton_cooling`.\nNote also the value of the master switch `get_process_kaon_compton()`, which controls both emission and cooling.\n")
        _ = t.def_method[_b_set_process_kaon_compton_cooling]("set_process_kaon_compton_cooling", docstring="set_process_kaon_compton_cooling(self: am3_mojo.AM3, arg0: bool) -> None\n\nSwitch for kaon inverse Compton cooling (am3_mojo addition).\nSet to False / True. Default: True.\nThe master switch `set_process_kaon_compton` must be True for cooling to be on.\n")
        _ = t.def_method[_b_get_kaons]("get_kaons", docstring="get_kaons(self: am3_mojo.AM3) -> numpy.typing.NDArray[numpy.float64]\n\nGet array with EdN_dEdV [1/cm³] of all charged kaons, both positive and negative (am3_mojo addition)\n")
