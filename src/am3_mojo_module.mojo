        _ = t.def_method[_b_set_process_pion_syn_cooling]("set_process_pion_syn_cooling", docstring="set_process_pion_syn_cooling(self: am3_mojo.AM3, arg0: bool) -> None\n\nInclude pion synchrotron cooling.\nSet to False (off) / True (on)\n")
