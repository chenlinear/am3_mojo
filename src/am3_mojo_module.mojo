        _ = t.def_method[_b_set_escape_fraction_neutrinos]("set_escape_fraction_neutrinos", docstring="set_escape_fraction_neutrinos(self: am3_mojo.AM3, arg0: typing.SupportsFloat | typing.SupportsIndex) -> None\n\n[Deprecation warning: Since version 1.2, it is recommended to work directly with escape rates rather than escape fractions.]\nSet escape fraction of neutrinos. The final neutrino escape tiemscale will be escape_timescale / escape_fraction_neutrinos.\nSet to 1.0 for free streaming of neutrinos or <1 for partial neutrino confinement.\nDefault: 1.0\n")
