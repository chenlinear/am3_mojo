        _ = t.def_method[_b_set_process_photopion_emission]("set_process_photopion_emission", docstring="set_process_photopion_emission(self: am3_mojo.AM3, arg0: bool) -> None\n\nInclude photopion pion production.\nSet to False (off) / True (on)\n")
