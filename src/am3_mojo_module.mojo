        _ = t.def_method[_b_set_escape_fraction_charged_particles]("set_escape_fraction_charged_particles", docstring="set_escape_fraction_charged_particles(self: am3_mojo.AM3, arg0: typing.SupportsFloat | typing.SupportsIndex) -> None\n\n[Deprecation warning: Since version 1.2, it is recommended to work directly with escape rates rather than escape fractions.]\nSet escape fractions of all charged particles to the same input value.\nThis action overwrites the escape fractions set before for individual species.\n")
        _ = t.def_method[_b_set_escape_fraction_muons]("set_escape_fraction_muons", docstring="set_escape_fraction_muons(self: am3_mojo.AM3, arg0: typing.SupportsFloat | typing.SupportsIndex) -> None\n\n[Deprecation warning: Since version 1.2, it is recommended to work directly with escape rates rather than escape fractions.]\nSet escape fraction of muons. The final muon escape tiemscale will be escape_timescale / escape_fraction_muons.\nSet to 1.0 for free streaming of muons or <1 for partial muon confinement.\nDefault: 1.0\n")
